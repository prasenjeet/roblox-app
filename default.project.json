        "$properties": {
          "ResetOnSpawn": false,
          "ZIndexBehavior": "Sibling"
        },
        "HUD": {
          "$path": "src/StarterGui/ObbyGui/HUD.lua"
        },
        "FinishScreen": {
          "$path": "src/StarterGui/ObbyGui/FinishScreen.lua"
        }
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "Gravity": 196.2
      },
      "CourseTemplate": {
        "$path": "src/Workspace/CourseTemplate.lua"
      }
    }
  }
}
