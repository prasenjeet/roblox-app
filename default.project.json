{
  "name": "ObbyGame",
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "GameManager": {
        "$path": "src/ServerScriptService/GameManager.server.lua"
      },
      "CoinService": {
        "$path": "src/ServerScriptService/CoinService.server.lua"
      },
      "TimerService": {
        "$path": "src/ServerScriptService/TimerService.server.lua"
      }
    },
    "StarterPlayer": {
